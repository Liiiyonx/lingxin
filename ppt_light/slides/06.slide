<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', overflow: 'hidden' }}>
  <Box style={{ position: 'absolute', top: 40, left: 80, flexDirection: 'row', alignItems: 'baseline', gap: 16 }}>
    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED', lineHeight: 1 }}>02</Text>
    <Box style={{ flexDirection: 'column', gap: 4 }}>
      <Text style={{ fontSize: 22, color: '#0F172A', fontWeight: 'bold' }}>老师端 · AI 数字人 小聆</Text>
      <Text style={{ fontSize: 12, color: '#64748B', letterSpacing: 2 }}>AI DIGITAL HUMAN · 7×24 OFFLINE COMPANION</Text>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', top: 120, left: 80, flexDirection: 'column', gap: 6 }}>
    <Text style={{ fontSize: 36, color: '#0F172A', fontWeight: 'bold', lineHeight: 1.2 }}>
      老师不在线?<Text style={{ color: '#EC4899' }}>数字分身</Text>接得住
    </Text>
  </Box>

  {/* 左:聊天演示 */}
  <Box style={{ position: 'absolute', top: 230, left: 80, width: 580, padding: 22, background: '#F8FAFC', borderRadius: 8, border: '1px solid #E2E8F0', flexDirection: 'column', gap: 16 }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, paddingBottom: 14, borderBottom: '1px solid #E2E8F0' }}>
      <Box style={{ width: 36, height: 36, borderRadius: 9999, background: 'linear-gradient(135deg, #A855F7, #EC4899)', alignItems: 'center', justifyContent: 'center' }}>
        <Text style={{ fontSize: 14, color: '#FFFFFF', fontWeight: 'bold' }}>聆</Text>
      </Box>
      <Box style={{ flex: 1 }}>
        <Text style={{ fontSize: 14, color: '#0F172A', fontWeight: 'bold' }}>小聆 · AI 分身</Text>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 6, marginTop: 2 }}>
          <Box style={{ width: 6, height: 6, borderRadius: 9999, background: '#10B981' }} />
          <Text style={{ fontSize: 11, color: '#64748B' }}>AI 分身 · 值班中</Text>
        </Box>
      </Box>
    </Box>

    <Box style={{ flexDirection: 'column', gap: 12 }}>
      <Box style={{ alignSelf: 'flex-end', maxWidth: '70%', padding: '10px 14px', background: '#7C3AED', borderRadius: '12px 12px 4px 12px' }}>
        <Text style={{ fontSize: 13, color: '#FFFFFF' }}>老师,最近压力很大,晚上总是睡不着……</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'flex-start', gap: 10 }}>
        <Box style={{ width: 28, height: 28, borderRadius: 9999, background: 'linear-gradient(135deg, #A855F7, #EC4899)', alignItems: 'center', justifyContent: 'center', flexShrink: 0 }}>
          <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 'bold' }}>聆</Text>
        </Box>
        <Box style={{ flexDirection: 'column', gap: 4 }}>
          <Box style={{ padding: '10px 14px', background: '#FFFFFF', border: '1px solid #A855F7', borderRadius: '4px 12px 12px 12px' }}>
            <Text style={{ fontSize: 13, color: '#0F172A', lineHeight: 1.5 }}>
              我是<Text style={{ color: '#A855F7', fontWeight: 'bold' }}> AI 分身小聆</Text>,老师今晚不在。先陪你聊聊:失眠多久了?
            </Text>
          </Box>
          <Box style={{ padding: '4px 10px', background: '#FEF2F2', border: '1px solid #EF4444', borderRadius: 4, alignSelf: 'flex-start' }}>
            <Text style={{ fontSize: 11, color: '#EF4444', fontWeight: 'bold' }}>⚠ 识别危机信号 → 自动生成高危预警</Text>
          </Box>
        </Box>
      </Box>
    </Box>
  </Box>

  {/* 右:三大能力卡片 */}
  <Box style={{ position: 'absolute', top: 230, right: 80, width: 400, flexDirection: 'column', gap: 18 }}>
    {[
      { num: '01', t: '明确 AI 身份标注', d: '对话气泡始终带"AI 分身"徽标,不冒充真人' },
      { num: '02', t: '语音朗读 + 幽默亲切', d: 'TTS 朗读学生问题,大模型以心理专家视角回应' },
      { num: '03', t: '危机识别 → 预警流转', d: '识别自伤等信号直接生成高危预警进入工单' },
    ].map(({ num, t, d }, i) => (
      <Box key={i} style={{ padding: 18, background: '#F8FAFC', borderRadius: 6, borderLeft: '3px solid #7C3AED', flexDirection: 'column', gap: 8 }}>
        <Text style={{ fontSize: 14, color: '#7C3AED', fontWeight: 'bold', letterSpacing: 2 }}>{num}</Text>
        <Text style={{ fontSize: 18, color: '#0F172A', fontWeight: 'bold' }}>{t}</Text>
        <Text style={{ fontSize: 13, color: '#64748B', lineHeight: 1.6 }}>{d}</Text>
      </Box>
    ))}
  </Box>

  <Box style={{ position: 'absolute', bottom: 30, right: 80, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 13, color: '#64748B' }}>06</Text>
    <Box style={{ width: 30, height: 1, background: '#64748B' }} />
    <Text style={{ fontSize: 13, color: '#64748B' }}>12</Text>
  </Box>
</Slide>
