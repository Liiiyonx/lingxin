<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', position: 'relative', overflow: 'hidden' }}>
  {/* 顶部小角标 */}
  <Box style={{ position: 'absolute', top: 40, left: 80, flexDirection: 'row', alignItems: 'baseline', gap: 16 }}>
    <Text style={{ fontSize: 40, fontWeight: 'bold', color: '#7C3AED', lineHeight: 1 }}>01</Text>
    <Box style={{ flexDirection: 'column', gap: 4 }}>
      <Text style={{ fontSize: 22, color: '#0F172A', fontWeight: 'bold' }}>辅导员工作台 + 情绪网络图</Text>
      <Text style={{ fontSize: 12, color: '#64748B', letterSpacing: 2 }}>COUNSELOR DASHBOARD · EMOTION NETWORK</Text>
    </Box>
  </Box>

  {/* 主标题 */}
  <Box style={{ position: 'absolute', top: 120, left: 80, flexDirection: 'column', gap: 6 }}>
    <Text style={{ fontSize: 36, color: '#0F172A', fontWeight: 'bold', lineHeight: 1.2 }}>
      50 名学生,<Text style={{ color: '#7C3AED' }}>一张图</Text>全局可见
    </Text>
    <Text style={{ fontSize: 14, color: '#64748B' }}>工作台汇总 30+ 项待办;情绪网络图按风险 / 班级 / 学院聚类</Text>
  </Box>

  {/* 左 数据卡片三联 */}
  <Box style={{ position: 'absolute', top: 250, left: 80, flexDirection: 'column', gap: 16, width: 340 }}>
    {[
      ['50', '名学生', '#7C3AED'],
      ['30+', '今日待办', '#EC4899'],
      ['1', '全局视图', '#A855F7'],
    ].map(([n, l, c], i) => (
      <Box key={i} style={{ padding: '18px 22px', background: '#F8FAFC', borderLeft: `4px solid ${c}`, borderRadius: 4, flexDirection: 'row', alignItems: 'baseline', gap: 18 }}>
        <Text style={{ fontSize: 56, fontWeight: 'bold', color: c, lineHeight: 1 }}>{n}</Text>
        <Text style={{ fontSize: 16, color: '#0F172A' }}>{l}</Text>
      </Box>
    ))}
    <Box style={{ padding: '12px 22px', background: '#FEF2F2', border: '1px solid #EF4444', borderRadius: 4 }}>
      <Text style={{ fontSize: 13, color: '#EF4444', fontWeight: 'bold' }}>▲ 当前 3 名高风险学生</Text>
    </Box>
  </Box>

  {/* 右 网络图示意 */}
  <Box style={{ position: 'absolute', top: 120, right: 80, width: 520, height: 480, background: '#F8FAFC', border: '1px solid #E2E8F0', borderRadius: 8, padding: 30 }}>
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', marginBottom: 24 }}>
      <Text style={{ fontSize: 14, color: '#0F172A', fontWeight: 'bold' }}>全班情绪网络</Text>
      <Text style={{ fontSize: 11, color: '#64748B' }}>点击节点直达师生对话</Text>
    </Box>

    {/* 节点网格 */}
    <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 12, justifyContent: 'space-between' }}>
      {[
        '#EF4444', '#EF4444', '#F59E0B', '#F59E0B', '#10B981',
        '#EF4444', '#F59E0B', '#10B981', '#10B981', '#10B981',
        '#10B981', '#10B981', '#EF4444', '#F59E0B', '#10B981',
        '#10B981', '#10B981', '#F59E0B', '#10B981', '#10B981',
      ].map((c, i) => (
        <Box key={i} style={{ width: 64, height: 64, borderRadius: 9999, background: c, opacity: 0.9, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 'bold' }}>{['郭','陈','李','王','张','刘','赵','孙','周','吴','徐','黄','何','马','朱','胡','林','郑','高','罗'][i]}</Text>
        </Box>
      ))}
    </Box>

    <Box style={{ position: 'absolute', bottom: 20, left: 30, flexDirection: 'row', gap: 18 }}>
      {[['#EF4444', '高风险'], ['#F59E0B', '中风险'], ['#10B981', '低风险']].map(([c, l], i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
          <Box style={{ width: 10, height: 10, borderRadius: 9999, background: c }} />
          <Text style={{ fontSize: 11, color: '#64748B' }}>{l}</Text>
        </Box>
      ))}
    </Box>
  </Box>

  <Box style={{ position: 'absolute', bottom: 30, right: 80, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 13, color: '#64748B' }}>04</Text>
    <Box style={{ width: 30, height: 1, background: '#64748B' }} />
    <Text style={{ fontSize: 13, color: '#64748B' }}>12</Text>
  </Box>
</Slide>
