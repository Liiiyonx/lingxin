# 聆心 - 环境变量配置模板
# ========================
# 复制此文件为 .env 并修改配置

# Flask 安全配置
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
HOST=0.0.0.0
PORT=5000
DEBUG=false
# 逗号分隔的允许来源；生产环境填域名或公网 IP，如 https://你的域名,http://你的域名
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# 阿里云 DashScope API（通义千问）
DASHSCOPE_API_KEY=sk-your-api-key-here

# LLM 参数
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# 数据库
DATABASE_URI=sqlite:///data/campus_mind.db

# Agora RTC (video call)
AGORA_APP_ID=
AGORA_TOKEN=
AGORA_APP_CERT=
