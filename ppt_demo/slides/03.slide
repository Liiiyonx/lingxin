<Slide style={{ width: 1280, height: 720, background: '#0B0B12', position: 'relative', overflow: 'hidden' }}>
  {/* 章节角标 */}
  <Box style={{ position: 'absolute', top: 40, left: 80, flexDirection: 'row', alignItems: 'baseline', gap: 16 }}>
    <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#A855F7', lineHeight: 1 }}>01</Text>
    <Box style={{ flexDirection: 'column', gap: 4 }}>
      <Text style={{ fontSize: 24, color: '#F5F5F7', fontWeight: 'bold' }}>辅导员工作台 + 情绪网络图</Text>
      <Text style={{ fontSize: 12, color: '#9CA3AF', letterSpacing: 2 }}>COUNSELOR DASHBOARD · EMOTION NETWORK</Text>
    </Box>
  </Box>

  {/* 主标题 */}
  <Box style={{ position: 'absolute', top: 130, left: 80, flexDirection: 'column', gap: 8 }}>
    <Text style={{ fontSize: 40, color: '#F5F5F7', fontWeight: 'bold', lineHeight: 1.2 }}>
      50 名学生，<Text style={{ color: '#A855F7' }}>一张图</Text>全局可见
    </Text>
    <Text style={{ fontSize: 15, color: '#9CA3AF', marginTop: 6, lineHeight: 1.6 }}>
      工作台汇总 30+ 项待办与日历提醒;情绪网络图按风险 / 班级 / 学院聚类
    </Text>
  </Box>

  {/* 左 数据卡片三联 */}
  <Box style={{ position: 'absolute', top: 280, left: 80, flexDirection: 'column', gap: 20, width: 340 }}>
    {[
      ['50', '名学生', '#A855F7'],
      ['30+', '今日待办', '#EC4899'],
      ['1', '全局视图', '#7C3AED'],
    ].map(([n, l, c], i) => (
      <Box key={i} style={{ padding: '18px 22px', background: '#15151F', borderLeft: `4px solid ${c}`, borderRadius: 4, flexDirection: 'row', alignItems: 'baseline', gap: 18 }}>
        <Text style={{ fontSize: 56, fontWeight: 'bold', color: c, lineHeight: 1 }}>{n}</Text>
        <Text style={{ fontSize: 16, color: '#F5F5F7' }}>{l}</Text>
      </Box>
    ))}
    <Box style={{ padding: '14px 22px', background: 'rgba(239,68,68,0.1)', border: '1px solid #EF4444', borderRadius: 4 }}>
      <Text style={{ fontSize: 14, color: '#EF4444', fontWeight: 'bold' }}>▲ 当前 3 名高风险学生</Text>
    </Box>
  </Box>

  {/* 右 网络图示意 — 用真实 Grid 布局不溢出 */}
  <Box style={{ position: 'absolute', top: 130, right: 80, width: 520, height: 480, background: 'radial-gradient(circle at center, #1A1A2E 0%, #0B0B12 70%)', border: '1px solid #2A2A3E', borderRadius: 8, padding: 30 }}>
    {/* 标题 */}
    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', marginBottom: 24 }}>
      <Text style={{ fontSize: 14, color: '#F5F5F7', fontWeight: 'bold' }}>全班情绪网络</Text>
      <Text style={{ fontSize: 11, color: '#9CA3AF' }}>点击节点直达师生对话</Text>
    </Box>

    {/* 节点网格 5x4 = 20个 */}
    <Box style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 12, justifyContent: 'space-between' }}>
      {[
        '#EF4444', '#EF4444', '#F59E0B', '#F59E0B', '#10B981',
        '#EF4444', '#F59E0B', '#10B981', '#10B981', '#10B981',
        '#10B981', '#10B981', '#EF4444', '#F59E0B', '#10B981',
        '#10B981', '#10B981', '#F59E0B', '#10B981', '#10B981',
      ].map((c, i) => (
        <Box key={i} style={{ width: 64, height: 64, borderRadius: 9999, background: c, opacity: 0.85, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 11, color: '#FFFFFF', fontWeight: 'bold' }}>{['郭','陈','李','王','张','刘','赵','孙','周','吴','徐','黄','何','马','朱','胡','林','郑','高','罗'][i]}</Text>
        </Box>
      ))}
    </Box>

    {/* 底部图例 */}
    <Box style={{ position: 'absolute', bottom: 20, left: 30, flexDirection: 'row', gap: 18 }}>
      {[['#EF4444', '高风险'], ['#F59E0B', '中风险'], ['#10B981', '低风险']].map(([c, l], i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}>
          <Box style={{ width: 10, height: 10, borderRadius: 9999, background: c }} />
          <Text style={{ fontSize: 11, color: '#9CA3AF' }}>{l}</Text>
        </Box>
      ))}
    </Box>
  </Box>

  {/* 页脚 */}
  <Box style={{ position: 'absolute', bottom: 30, right: 80, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 13, color: '#9CA3AF' }}>03</Text>
    <Box style={{ width: 30, height: 1, background: '#9CA3AF' }} />
    <Text style={{ fontSize: 13, color: '#9CA3AF' }}>07</Text>
  </Box>
</Slide>
