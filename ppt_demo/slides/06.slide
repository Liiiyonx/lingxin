<Slide style={{ width: 1280, height: 720, background: '#0B0B12', position: 'relative', overflow: 'hidden' }}>
  {/* 章节角标 */}
  <Box style={{ position: 'absolute', top: 40, left: 80, flexDirection: 'row', alignItems: 'baseline', gap: 16 }}>
    <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#A855F7', lineHeight: 1 }}>04</Text>
    <Box style={{ flexDirection: 'column', gap: 4 }}>
      <Text style={{ fontSize: 24, color: '#F5F5F7', fontWeight: 'bold' }}>危机闭环 · 工单流转</Text>
      <Text style={{ fontSize: 12, color: '#9CA3AF', letterSpacing: 2 }}>CRISIS WORKFLOW · EVIDENCE-DRIVEN</Text>
    </Box>
  </Box>

  {/* 主标题 */}
  <Box style={{ position: 'absolute', top: 130, left: 80, right: 80, flexDirection: 'column', gap: 6 }}>
    <Text style={{ fontSize: 36, color: '#F5F5F7', fontWeight: 'bold', lineHeight: 1.1 }}>
      <Text style={{ color: '#A855F7' }}>取最高不降级</Text> · 跨角色协同
    </Text>
    <Text style={{ fontSize: 14, color: '#9CA3AF' }}>
      测评 / 谈心 / 视频 / 数字人 多来源证据,只升不降;危机跨学工处一键指派关闭
    </Text>
  </Box>

  {/* 中央横向五步流程 */}
  <Box style={{ position: 'absolute', top: 240, left: 80, right: 80, flexDirection: 'row', alignItems: 'stretch', gap: 0 }}>
    {[
      { ic: '📋', t: '测评预警', desc: 'PHQ-9 高风险触发', c: '#F59E0B' },
      { ic: '💬', t: '谈心记录', desc: '中风险跟进', c: '#A855F7' },
      { ic: '📹', t: '视频情绪', desc: '通话结论回写', c: '#A855F7' },
      { ic: '🤖', t: 'AI 危机识别', desc: '数字人识别 → 预警', c: '#EF4444' },
      { ic: '🚨', t: '危机工单', desc: '跨学工处指派关闭', c: '#EF4444' },
    ].map((s, i, arr) => (
      <Box key={i} style={{ flex: 1, flexDirection: 'column', alignItems: 'center', paddingHorizontal: 8 }}>
        <Box style={{ width: 72, height: 72, borderRadius: 9999, background: `${s.c}25`, border: `2px solid ${s.c}`, alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 32 }}>{s.ic}</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#F5F5F7', fontWeight: 'bold', marginTop: 10 }}>{s.t}</Text>
        <Text style={{ fontSize: 12, color: '#9CA3AF', marginTop: 4, textAlign: 'center' }}>{s.desc}</Text>
        {i < arr.length - 1 && (
          <Text style={{ position: 'absolute', top: 28, left: '50%', transform: 'translateX(0)', fontSize: 18, color: '#A855F7' }}>→</Text>
        )}
      </Box>
    ))}
  </Box>

  {/* 流程箭头(独立层) */}
  <Box style={{ position: 'absolute', top: 270, left: 260, right: 260, flexDirection: 'row', justifyContent: 'space-between', opacity: 0.7 }}>
    {[0, 1, 2, 3].map((i) => (
      <Box key={i} style={{ flex: 1, alignItems: 'center' }}>
        <Text style={{ fontSize: 24, color: '#A855F7' }}>›</Text>
      </Box>
    ))}
  </Box>

  {/* 底部证据栏 */}
  <Box style={{ position: 'absolute', bottom: 130, left: 80, right: 80, padding: 22, background: '#15151F', border: '1px solid #2A2A3E', borderRadius: 8, flexDirection: 'row', alignItems: 'center', gap: 24 }}>
    <Box style={{ width: 80, height: 80, borderRadius: 9999, background: 'linear-gradient(135deg, #A855F7, #EC4899)', alignItems: 'center', justifyContent: 'center' }}>
      <Text style={{ fontSize: 32, color: '#FFFFFF', fontWeight: 'bold' }}>郭</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 8 }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
        <Text style={{ fontSize: 18, color: '#F5F5F7', fontWeight: 'bold' }}>郭诗雨</Text>
        <Box style={{ padding: '3px 10px', background: 'rgba(239,68,68,0.2)', borderRadius: 4 }}>
          <Text style={{ fontSize: 12, color: '#EF4444', fontWeight: 'bold' }}>当前:危机/高风险</Text>
        </Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 8 }}>
        {[
          ['测评', '10/14', '#F59E0B'],
          ['谈心', '10/20', '#A855F7'],
          ['视频', '10/25', '#A855F7'],
          ['数字人', '10/27', '#EF4444'],
        ].map(([src, dt, c], i) => (
          <Box key={i} style={{ padding: '4px 10px', background: '#0B0B12', border: `1px solid ${c}`, borderRadius: 4, flexDirection: 'row', gap: 6 }}>
            <Text style={{ fontSize: 11, color: c }}>{src}</Text>
            <Text style={{ fontSize: 11, color: '#9CA3AF' }}>{dt}</Text>
          </Box>
        ))}
      </Box>
    </Box>
  </Box>

  {/* 底部说明 */}
  <Box style={{ position: 'absolute', bottom: 50, left: 80, right: 80, justifyContent: 'center' }}>
    <Text style={{ fontSize: 14, color: '#9CA3AF', textAlign: 'center' }}>
      工单<Text style={{ color: '#A855F7' }}> 关闭后</Text>系统根据未解决预警自动<Text style={{ color: '#A855F7' }}> 重算</Text>学生风险状态
    </Text>
  </Box>

  {/* 页脚 */}
  <Box style={{ position: 'absolute', bottom: 30, right: 80, flexDirection: 'row', alignItems: 'center', gap: 8 }}>
    <Text style={{ fontSize: 13, color: '#9CA3AF' }}>06</Text>
    <Box style={{ width: 30, height: 1, background: '#9CA3AF' }} />
    <Text style={{ fontSize: 13, color: '#9CA3AF' }}>07</Text>
  </Box>
</Slide>
